<Window x:Class="ScadaDashboard.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pm="clr-namespace:ScadaDashboard.Pipeline"
        xmlns:c="clr-namespace:ScadaDashboard.Controls"
        Title="Boru Hattı Ağı - Canlı Harita"
        Height="820" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20,14"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BORU HATTI AĞI - CANLI HARİTA" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="Ağ sağlığı ve akış izleme"/>
                        <Run x:Name="SourceLabel" Text="  •  Veri kaynağı: SİMÜLASYON" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="OpenDashboard_Click" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Makine Paneli" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="LayersButton" Style="{StaticResource GhostToggle}"
                                  Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Katmanlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=LayersButton}" Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=LayersButton}" StaysOpen="False"
                           AllowsTransparency="True" HorizontalOffset="-40" VerticalOffset="6">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="KATMANLAR" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <CheckBox Content="İl sınırları" IsChecked="True" Margin="0,3" Foreground="{StaticResource TextBrush}"
                                          Checked="LayerProvinces" Unchecked="LayerProvinces"/>
                                <CheckBox Content="Coğrafi adlar (deniz/ülke/bölge)" IsChecked="True" Margin="0,3" Foreground="{StaticResource TextBrush}"
                                          Checked="LayerGeo" Unchecked="LayerGeo"/>
                                <CheckBox Content="Akış göstergeleri" IsChecked="True" Margin="0,3" Foreground="{StaticResource TextBrush}"
                                          Checked="LayerFlow" Unchecked="LayerFlow"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Click="OpenSettings_Click" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="AlarmBox" Background="#E74C3C" CornerRadius="6" Padding="10,5" Margin="0,0,14,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="AlarmText" FontSize="12" FontWeight="Bold" Foreground="#0F1620"/>
                    </Border>
                    <TextBlock x:Name="Clock" FontSize="13" Style="{StaticResource NumText}"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Harita + istasyon detay paneli -->
        <Grid Grid.Row="1">
            <pm:PipelineMapControl x:Name="Map" ClipToBounds="True"/>

            <!-- Yuzen bolge cubugu: bir bolgeye zoom/izole et -->
            <Border x:Name="RegionBarHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    Background="#CC1A2634" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <StackPanel x:Name="RegionBar" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <Border x:Name="Detail" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="330"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DetailId" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CloseDetail_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="26" Height="24" Padding="0" Style="{StaticResource GhostButton}"
                                ToolTip="Paneli kapat">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </Grid>

                    <Border x:Name="DetailStatusBox" CornerRadius="6" Padding="10,6" Margin="0,12,0,0" Background="#2ECC71">
                        <TextBlock x:Name="DetailStatus" FontSize="13" FontWeight="Bold" Foreground="#0F1620"/>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="KALAN ÖMÜR (RUL)" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DetailRul" FontSize="15" Style="{StaticResource NumText}"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SAĞLIK" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DetailHealth" FontSize="15" Style="{StaticResource NumText}"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="UnitsButton" Content="Üniteleri Aç" Click="OpenUnits_Click"
                            AutomationProperties.AutomationId="UnitsButton"
                            Style="{StaticResource GhostButton}" Margin="0,12,0,0" Padding="10,6"
                            HorizontalAlignment="Left"/>

                    <Grid Margin="0,16,0,2">
                        <TextBlock Text="Titreşim" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="VibVal" HorizontalAlignment="Right" FontSize="12"
                                   Style="{StaticResource NumText}" Foreground="#FFD166"/>
                    </Grid>
                    <c:MiniChart x:Name="VibChart" Height="46" Background="{StaticResource TrackBrush}" LineBrush="#FFD166"/>

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Yatak Sıcaklığı" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="BtVal" HorizontalAlignment="Right" FontSize="12"
                                   Style="{StaticResource NumText}" Foreground="#FF6B6B"/>
                    </Grid>
                    <c:MiniChart x:Name="BtChart" Height="46" Background="{StaticResource TrackBrush}" LineBrush="#FF6B6B"/>

                    <Grid Margin="0,10,0,2">
                        <TextBlock Text="Basma Basıncı" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="DpVal" HorizontalAlignment="Right" FontSize="12"
                                   Style="{StaticResource NumText}" Foreground="#4ECDC4"/>
                    </Grid>
                    <c:MiniChart x:Name="DpChart" Height="46" Background="{StaticResource TrackBrush}" LineBrush="#4ECDC4"/>

                    <!-- Tum sensorler (yalnizca snapshot kaynaginda; en kotu unite) -->
                    <TextBlock x:Name="SensorHeader" Visibility="Collapsed" Margin="0,18,0,6"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <ItemsControl x:Name="SensorList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Satir: ince ayirici; grup basligi ayiricisiz, vurgulu -->
                                <Border x:Name="RowBd" BorderBrush="#1E3348"
                                        BorderThickness="0,0,0,0.6" Padding="0,3">
                                    <Grid>
                                        <TextBlock x:Name="NameTb" Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="ValTb" Text="{Binding Value}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="RowBd" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="RowBd" Property="Padding" Value="0,10,0,2"/>
                                        <Setter TargetName="NameTb" Property="FontSize" Value="9.5"/>
                                        <Setter TargetName="NameTb" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="NameTb" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="ValTb" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- Nominal bant asimi: deger uyari/kritik renginde -->
                                    <DataTrigger Binding="{Binding Alert}" Value="1">
                                        <Setter TargetName="ValTb" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        <Setter TargetName="ValTb" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Alert}" Value="2">
                                        <Setter TargetName="ValTb" Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                        <Setter TargetName="ValTb" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt bar: aciklama + secili dugum -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="18,10"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kategori onay kutulari (dairesel): isaret kaldirilinca o tur gizlenir -->
                    <CheckBox Tag="CS" IsChecked="True" Checked="CategoryToggle" Unchecked="CategoryToggle"
                              Style="{StaticResource CircleCheck}" Background="#8CA3B8"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="İstasyonları göster/gizle">
                        <TextBlock Text="İstasyon:" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </CheckBox>
                    <Ellipse Width="10" Height="10" Fill="#2ECC71" Margin="0,0,4,0"/>
                    <TextBlock Text="Sağlıklı" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#F1C40F" Margin="0,0,4,0"/>
                    <TextBlock Text="Uyarı" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#E67E22" Margin="0,0,4,0"/>
                    <TextBlock Text="Riskli" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#E74C3C" Margin="0,0,4,0"/>
                    <TextBlock Text="Kritik" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Düğüm:" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Tag="BORDER" IsChecked="True" Checked="CategoryToggle" Unchecked="CategoryToggle"
                              Style="{StaticResource CircleCheck}" Background="#4E9BF5"
                              VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Sınır düğümlerini göster/gizle">
                        <TextBlock Text="Sınır" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    </CheckBox>
                    <CheckBox Tag="OFFTAKE" IsChecked="True" Checked="CategoryToggle" Unchecked="CategoryToggle"
                              Style="{StaticResource CircleCheck}" Background="#C58AF5"
                              VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Çıkış düğümlerini göster/gizle">
                        <TextBlock Text="Çıkış" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    </CheckBox>
                    <CheckBox Tag="STORAGE" IsChecked="True" Checked="CategoryToggle" Unchecked="CategoryToggle"
                              Style="{StaticResource CircleCheck}" Background="#4ECDC4"
                              VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Depoları göster/gizle">
                        <TextBlock Text="Depo" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    </CheckBox>
                    <CheckBox Tag="OTHER" IsChecked="True" Checked="CategoryToggle" Unchecked="CategoryToggle"
                              Style="{StaticResource CircleCheck}" Background="#8CA3B8"
                              VerticalAlignment="Center" Margin="0,0,20,0" ToolTip="Kavşak / LNG / FSRU / terminal düğümlerini göster/gizle">
                        <TextBlock Text="Diğer" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    </CheckBox>

                    <TextBlock Text="Akış: düşük" FontSize="11" Foreground="#4ECDC4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="—&gt;" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="yüksek" FontSize="11" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="SelectedInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="Bir istasyona tıklayın"/>
            </Grid>
        </Border>
    </Grid>
</Window>
