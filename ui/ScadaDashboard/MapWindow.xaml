<Window x:Class="ScadaDashboard.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pm="clr-namespace:ScadaDashboard.Pipeline"
        Title="Boru Hatti Agi - Canli Harita"
        Height="820" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20,14"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BORU HATTI AGI - CANLI HARITA" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="Ag sagligi ve akis izleme"/>
                        <Run Text="  •  Veri kaynagi: SIMULASYON" Foreground="#F1C40F"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="Clock" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>

        <!-- Harita -->
        <pm:PipelineMapControl x:Name="Map" Grid.Row="1"/>

        <!-- Alt bar: aciklama + secili dugum -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="18,10"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Istasyon:" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse Width="10" Height="10" Fill="#2ECC71" Margin="0,0,4,0"/>
                    <TextBlock Text="Saglikli" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#F1C40F" Margin="0,0,4,0"/>
                    <TextBlock Text="Uyari" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#E67E22" Margin="0,0,4,0"/>
                    <TextBlock Text="Riskli" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#E74C3C" Margin="0,0,4,0"/>
                    <TextBlock Text="Kritik" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Dugum:" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse Width="10" Height="10" Fill="#4E9BF5" Margin="0,0,4,0"/>
                    <TextBlock Text="Sinir" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="10" Height="10" Fill="#C58AF5" Margin="0,0,4,0"/>
                    <TextBlock Text="Cikis" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Akis: dusuk" FontSize="11" Foreground="#4ECDC4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="—&gt;" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="yuksek" FontSize="11" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="SelectedInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="Bir istasyona tiklayin"/>
            </Grid>
        </Border>
    </Grid>
</Window>
