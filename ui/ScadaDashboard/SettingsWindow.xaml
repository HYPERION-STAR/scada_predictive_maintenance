<Window x:Class="ScadaDashboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <StackPanel Margin="22,18">
        <TextBlock Text="CANLI SUNUCULAR" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="Gaz: canlı API · Petrol: MySQL (erişilemezse canlı) · Sağlık: AI respond."
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"
                   TextWrapping="Wrap"/>

        <TextBlock Text="Canlı adres (telemetri + topoloji)" FontSize="11"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,2"/>
        <TextBox x:Name="LiveUrlBox" Padding="6,4" FontSize="12"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource StrokeBrush}"/>

        <TextBlock Text="AI yanıt tabanı (since imleci)" FontSize="11"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
        <TextBox x:Name="AiRespondUrlBox" Padding="6,4" FontSize="12"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource StrokeBrush}"
                 ToolTip="http://host:9000 — GET /ai_respond?since=N (latest değil)"/>

        <TextBlock Text="MySQL (petrol telemetrisi)" FontSize="11"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,2"/>
        <TextBox x:Name="DbConnBox" Padding="6,4" FontSize="11"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource StrokeBrush}" TextWrapping="Wrap" AcceptsReturn="False"
                 ToolTip="live_entity_current — oil_pump / oil_storage. Boş = petrol de canlı API."/>
        <TextBlock Text="DB erişilemezse petrol otomatik canlı API'ye düşer."
                   FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                   TextWrapping="Wrap"/>

        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="GÖRÜNÜM" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <CheckBox x:Name="LightThemeBox" Content="Açık tema" Foreground="{DynamicResource TextBrush}"
                          Checked="Theme_Changed" Unchecked="Theme_Changed"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="ALARM" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Kritik eşik (%). Alarm her zaman en kötü üniteye bakar; eşiği düşürmek alarmı seyrekleştirir."/>
                <Grid>
                    <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="40" TickFrequency="5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,52,0"/>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextBrush}"
                               Text="{Binding Value, ElementName=ThresholdSlider, StringFormat=%{0:0}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="#E74C3C" FontSize="11"
                   Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Vazgeç" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                    Padding="14,6" Margin="0,0,10,0"/>
            <Button Content="Uygula" Click="Apply_Click" Style="{StaticResource GhostButton}"
                    Padding="14,6" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>
